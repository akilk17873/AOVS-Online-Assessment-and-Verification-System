# AOVS Backend Environment Configuration

# Server Port (Render sets this dynamically)
PORT=3000
MOCK_COLLEGE_PORT=3000

# MongoDB Atlas Connection URI (optional - falls back to in-memory repository)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/aovs?retryWrites=true&w=majority

# College / Instructor Credentials
TEST_STUDENT_ID=TEST001
TEST_PASSWORD=Test@123
TEST_INSTRUCTOR_ID=INST001
TEST_INSTRUCTOR_PASSWORD=Instructor@123
TEST_ADMIN_ID=admin
TEST_ADMIN_PASSWORD=Admin@123

